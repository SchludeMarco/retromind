{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build && node scripts/edition.mjs",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/gaming", "destination": "/gaming/index.html" }],
  "functions": {
    "api/gemini.js": { "maxDuration": 60 },
    "api/video.js": { "maxDuration": 60 },
    "api/feedback.js": { "maxDuration": 15 }
  }
}
